<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never">
  <info>
    <title>American Fisheries Society</title>
    <id>http://www.zotero.org/styles/american-fisheries-society</id>
    <link href="http://www.zotero.org/styles/american-fisheries-society" rel="self"/>
    <category citation-format="author-date"/>
    <category field="biology"/>
    <updated>2021-02-12T04:50:30+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name and="text" delimiter=", " initialize-with=". "/>
    </names>
  </macro>
  <macro name="year-date">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=" ">
        <text macro="author"/>
        <text macro="year-date"/>
      </group>
    </layout>
  </citation>
  <bibliography>
    <layout>
      <group delimiter=". ">
        <text macro="author"/>
        <text macro="year-date"/>
        <text variable="title"/>
        <text variable="container-title"/>
        <group delimiter=":">
          <text variable="volume"/>
          <text variable="page"/>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
